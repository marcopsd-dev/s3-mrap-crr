{
  "OptionalConfigurations": {
    "Description": "Optional enhancements for all S3 buckets in the multi-region architecture (Replica, Main, and Logging buckets)",
    
    "IntelligentTiering": {
      "Description": "Automatic storage class transitions for cost optimization - applicable to all buckets",
      "ApplicableTo": ["ReplicaBucket", "MainS3Bucket", "LoggingBucket"],
      "CostSavings": {
        "ArchiveAccessTier": "68% savings after 90 days of no access",
        "DeepArchiveAccessTier": "95% savings after 180 days of no access"
      },
      "Requirements": {
        "ObjectLockCompatibility": "Fully compatible with Object Lock COMPLIANCE mode",
        "VersioningCompatibility": "Fully compatible with versioning",
        "ReplicationCompatibility": "Fully compatible with CRR - replicated objects maintain storage class"
      },
      "HowToUse": "Add this to any bucket's Properties section (same level as VersioningConfiguration)",
      "Configuration": {
        "IntelligentTieringConfigurations": [
          {
            "Id": "EntireBucketIntelligentTiering",
            "Status": "Enabled",
            "Tierings": [
              {
                "Days": 90,
                "AccessTier": "ARCHIVE_ACCESS"
              },
              {
                "Days": 180,
                "AccessTier": "DEEP_ARCHIVE_ACCESS"
              }
            ]
          }
        ]
      },
      "Notes": [
        "Objects must be uploaded with INTELLIGENT_TIERING storage class to benefit",
        "Minimum object size: 128KB (smaller objects stay in Frequent Access)",
        "No retrieval fees for Frequent/Infrequent Access tiers",
        "Archive tiers require restoration before access (3-5 hours for Archive, 12 hours for Deep Archive)",
        "Monitoring fee: $0.0025 per 1,000 objects per month",
        "Recommended for: Long-term storage with unpredictable access patterns"
      ],
      "ApplyTo": {
        "ReplicaBucket": "Recommended for infrequently accessed disaster recovery data",
        "MainS3Bucket": "Recommended if access patterns vary significantly",
        "LoggingBucket": "Highly recommended - logs are rarely accessed after 30-90 days"
      }
    },
    
    "EnhancedKMSSecurityConditions": {
      "Description": "Additional security conditions for KMS key policies - applicable to all KMS keys",
      "ApplicableTo": ["ReplicaKmsKey", "MainS3KmsKey", "LoggingKmsKey"],
      "Warning": "Test conditions in a non-production environment first to avoid lockouts!",
      "HowToUse": "Add Condition blocks to the AllowAdminRoleFullAccess statement in any KMS Key Policy",
      
      "Options": {
        "RequireMFAForAdmin": {
          "Description": "Admin must use MFA to perform KMS operations",
          "SecurityLevel": "High",
          "ApplicableTo": "AllowAdminRoleFullAccess statement in any KMS key",
          "Configuration": {
            "Condition": {
              "Bool": {
                "aws:MultiFactorAuthPresent": "true"
              }
            }
          },
          "Impact": "Admins must authenticate with MFA device to use KMS keys",
          "Recommendation": "Highly recommended for production environments"
        },
        
        "RestrictToSpecificVPC": {
          "Description": "KMS operations only allowed from specified VPC",
          "SecurityLevel": "High",
          "ApplicableTo": "AllowAdminRoleFullAccess statement in any KMS key",
          "Configuration": {
            "Condition": {
              "StringEquals": {
                "aws:SourceVpc": "vpc-XXXXXXXX"
              }
            }
          },
          "Placeholders": {
            "vpc-XXXXXXXX": "Replace with your VPC ID (e.g., vpc-0a1b2c3d4e5f6g7h8)"
          },
          "Impact": "All KMS operations must originate from the specified VPC",
          "Recommendation": "Use if all access is from within a VPC",
          "Note": "Not compatible with Lambda@Edge or CloudFront"
        },
        
        "RestrictByIPAddress": {
          "Description": "KMS operations only allowed from corporate IP range",
          "SecurityLevel": "Medium-High",
          "ApplicableTo": "AllowAdminRoleFullAccess statement in any KMS key",
          "Configuration": {
            "Condition": {
              "IpAddress": {
                "aws:SourceIp": [
                  "203.0.113.0/24",
                  "198.51.100.0/24"
                ]
              }
            }
          },
          "Placeholders": {
            "203.0.113.0/24": "Replace with your corporate IP range",
            "198.51.100.0/24": "Add multiple ranges as needed"
          },
          "Impact": "All KMS operations must originate from specified IP ranges",
          "Recommendation": "Use for on-premises access or known IP ranges",
          "Note": "May cause issues if IP addresses change (e.g., remote workers, cloud services)"
        },
        
        "RestrictByTime": {
          "Description": "KMS operations only allowed during business hours",
          "SecurityLevel": "Medium",
          "ApplicableTo": "AllowAdminRoleFullAccess statement in any KMS key",
          "Configuration": {
            "Condition": {
              "DateGreaterThan": {
                "aws:CurrentTime": "2024-01-01T00:00:00Z"
              },
              "DateLessThan": {
                "aws:CurrentTime": "2030-12-31T23:59:59Z"
              }
            }
          },
          "Note": "Adjust dates for time-based restrictions or business hours",
          "Recommendation": "Useful for temporary access or maintenance windows"
        },
        
        "CombineMFAandVPC": {
          "Description": "Requires BOTH MFA AND VPC access",
          "SecurityLevel": "Very High",
          "ApplicableTo": "AllowAdminRoleFullAccess statement in any KMS key",
          "Configuration": {
            "Condition": {
              "Bool": {
                "aws:MultiFactorAuthPresent": "true"
              },
              "StringEquals": {
                "aws:SourceVpc": "vpc-XXXXXXXX"
              }
            }
          },
          "Placeholders": {
            "vpc-XXXXXXXX": "Replace with your VPC ID"
          },
          "Impact": "Admin must use MFA AND be in specified VPC",
          "Recommendation": "Most secure option - best for highly sensitive data",
          "Note": "Ensure admins can access VPC and have MFA configured"
        },
        
        "CombineMFAandIP": {
          "Description": "Requires BOTH MFA AND corporate IP range",
          "SecurityLevel": "Very High",
          "ApplicableTo": "AllowAdminRoleFullAccess statement in any KMS key",
          "Configuration": {
            "Condition": {
              "Bool": {
                "aws:MultiFactorAuthPresent": "true"
              },
              "IpAddress": {
                "aws:SourceIp": [
                  "203.0.113.0/24"
                ]
              }
            }
          },
          "Placeholders": {
            "203.0.113.0/24": "Replace with your corporate IP range"
          },
          "Impact": "Admin must use MFA AND be in corporate network",
          "Recommendation": "Alternative to VPC restriction for on-premises scenarios"
        }
      }
    },
    
    "ReplicationRoleAccessForReplicaKMS": {
      "Description": "Grant ReplicationRole access to ReplicaKmsKey after parent stack deployment",
      "ApplicableTo": ["ReplicaKmsKey only"],
      "When": "After parent stack (Stack1) creates the ReplicationRole",
      "StackLocation": "Replica Stack (Standalone)",
      "Note": "This statement is REQUIRED for replication to work - not optional, but must be added after initial deployment",
      "Configuration": {
        "Sid": "AllowReplicationRoleToEncrypt",
        "Effect": "Allow",
        "Principal": {
          "AWS": "arn:aws:iam::ACCOUNT_ID:role/ReplicationRole-STACK_NAME"
        },
        "Action": [
          "kms:Encrypt",
          "kms:GenerateDataKey",
          "kms:DescribeKey"
        ],
        "Resource": "*"
      },
      "Placeholders": {
        "ACCOUNT_ID": "Your AWS account ID (12 digits)",
        "STACK_NAME": "The stack name used when deploying parent stack"
      },
      "DeploymentSteps": [
        "1. Deploy Replica Stack WITHOUT this statement (initial deployment)",
        "2. Deploy Parent Stack with Stack1 (creates ReplicationRole)",
        "3. Get ReplicationRole ARN from Stack1 outputs: ReplicationRoleARN",
        "4. Add this statement to ReplicaKmsKey.KeyPolicy.Statement array",
        "5. Update Replica Stack (CloudFormation stack update)",
        "6. Replication will now work with encryption"
      ],
      "HowToAdd": "Append this statement to ReplicaKmsKey.Properties.KeyPolicy.Statement array (after AllowAdminRoleFullAccess statement)",
      "VerifyReplication": "After update, upload a test file to main bucket and verify it appears in replica bucket within 15 minutes"
    },
    
    "ReplicaBucketPolicyForReplicationRole": {
      "Description": "Grant ReplicationRole access to ReplicaBucket after parent stack deployment",
      "ApplicableTo": ["ReplicaBucket only"],
      "When": "After parent stack (Stack1) creates the ReplicationRole",
      "StackLocation": "Replica Stack (Standalone) - ReplicaBucketPolicy",
      "Note": "This statement is REQUIRED for replication to work - not optional, but must be added after initial deployment",
      "Configuration": {
        "Sid": "AllowReplicationRoleToReplicate",
        "Effect": "Allow",
        "Principal": {
          "AWS": "arn:aws:iam::ACCOUNT_ID:role/ReplicationRole-STACK_NAME"
        },
        "Action": [
          "s3:ReplicateObject",
          "s3:ReplicateDelete",
          "s3:ReplicateTags",
          "s3:GetObjectVersionTagging",
          "s3:ObjectOwnerOverrideToBucketOwner"
        ],
        "Resource": [
          {
            "Fn::Join": [
              "",
              [
                {
                  "Fn::GetAtt": [
                    "ReplicaBucket",
                    "Arn"
                  ]
                },
                "/*"
              ]
            ]
          }
        ]
      },
      "Placeholders": {
        "ACCOUNT_ID": "Your AWS account ID (12 digits)",
        "STACK_NAME": "The stack name used when deploying parent stack"
      },
      "DeploymentSteps": [
        "1. Deploy Replica Stack WITHOUT this statement (initial deployment)",
        "2. Deploy Parent Stack with Stack1 (creates ReplicationRole)",
        "3. Get ReplicationRole ARN from Stack1 outputs: ReplicationRoleARN",
        "4. Add this statement to ReplicaBucketPolicy.PolicyDocument.Statement array",
        "5. Update Replica Stack (CloudFormation stack update)",
        "6. Replication will now have full permissions"
      ],
      "HowToAdd": "Append this statement to ReplicaBucketPolicy.Properties.PolicyDocument.Statement array (after AllowAdminRoleFullAccess statement)"
    }
  },
  
