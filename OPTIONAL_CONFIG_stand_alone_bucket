    "Example3_ReplicaKmsKeyWithMFAAndReplicationRole": {
      "Description": "Complete ReplicaKmsKey policy with MFA requirement for admin AND replication role access",
      "Stack": "Replica Stack",
      "Resource": "ReplicaKmsKey",
      "HowToApply": "Replace entire KeyPolicy in ReplicaKmsKey.Properties",
      "Note": "Deploy this AFTER parent stack creates ReplicationRole",
      "FullConfiguration": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Sid": "AllowRootAccountFullAccess",
            "Effect": "Allow",
            "Principal": {
              "AWS": {
                "Fn::Sub": "arn:aws:iam::${AWS::AccountId}:root"
              }
            },
            "Action": "kms:*",
            "Resource": "*"
          },
          {
            "Sid": "AllowAdminRoleFullAccessWithMFA",
            "Effect": "Allow",
            "Principal": {
              "AWS": {
                "Ref": "AdminRoleARN"
              }
            },
            "Action": "kms:*",
            "Resource": "*",
            "Condition": {
              "Bool": {
                "aws:MultiFactorAuthPresent": "true"
              }
            }
          },
          {
            "Sid": "AllowReplicationRoleToEncrypt",
            "Effect": "Allow",
            "Principal": {
              "AWS": "arn:aws:iam::123456789012:role/ReplicationRole-stack-name"
            },
            "Action": [
              "kms:Encrypt",
              "kms:GenerateDataKey",
              "kms:DescribeKey"
            ],
            "Resource": "*"
          }
        ]
      },
      "Placeholders": {
        "123456789012": "Replace with your AWS account ID",
        "ReplicationRole-stack-name": "Replace with actual ReplicationRole name from Stack1 outputs"
      }
    },
    
